{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "data/**",
          "config/**",
          "knowledge.json"
        ]
      }
    },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/(.*\\.(html|css|js|ico|png|jpg|svg))", "dest": "/public/$1" },
    { "src": "/", "dest": "/public/index.html" }
  ]
}
